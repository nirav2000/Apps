{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apps-pronunciation-api",
  "main": "pronunciation-worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "DEFAULT_TTS_VOICE": "cedar",
    "TTS_MODEL": "gpt-4o-mini-tts"
  }
}
