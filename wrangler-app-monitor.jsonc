{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apps-monitor-api",
  "main": "app-monitor-worker.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "APP_MONITOR_DATA", "bucket_name": "apps-monitor-data" },
    { "binding": "LEGACY_SNAG_MEDIA", "bucket_name": "snag-media" }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://nirav2000.github.io"
  }
}
