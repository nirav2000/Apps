rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared identity metadata is server-owned. Browser clients obtain a
    // deliberately small projection from the auth service, never raw documents.
    match /users/{document=**} {
      allow read, write: if false;
    }
    match /authSubjects/{document=**} {
      allow read, write: if false;
    }
    match /apps/{document=**} {
      allow read, write: if false;
    }
    match /sessions/{document=**} {
      allow read, write: if false;
    }
    match /credentials/{document=**} {
      allow read, write: if false;
    }
    match /audit/{document=**} {
      allow read, write: if false;
    }
    match /viewContexts/{document=**} {
      allow read, write: if false;
    }

    // Default deny for any future identity collection until explicitly reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
